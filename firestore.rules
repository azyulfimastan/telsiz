rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    match /users/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;

      // Bildirim abonelikleri: sahibi yazar; sahibi ve arkadaşları okur/siler
      match /push/{id} {
        allow create, update: if signedIn() && request.auth.uid == uid;
        allow read, delete: if signedIn() && (request.auth.uid == uid
          || exists(/databases/$(database)/documents/chats/$(uid + '_' + request.auth.uid))
          || exists(/databases/$(database)/documents/chats/$(request.auth.uid + '_' + uid)));
      }
    }

    // Arkadaşlık isteği: id = "<gönderen>_<alıcı>"
    match /requests/{id} {
      allow read: if signedIn() &&
        (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if signedIn() && request.resource.data.from == request.auth.uid
        && request.resource.data.status == "pending";
      allow update: if signedIn() && resource.data.to == request.auth.uid;
      allow delete: if signedIn() &&
        (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }

    // Sohbet: id = iki uid'nin sıralı birleşimi
    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      // Sohbet yalnızca karşı taraftan gelen arkadaşlık isteği kabul edilirken açılabilir
      allow create: if signedIn() && request.resource.data.members.size() == 2
        && (chatId == request.resource.data.members[0] + '_' + request.resource.data.members[1]
         || chatId == request.resource.data.members[1] + '_' + request.resource.data.members[0])
        && ((request.resource.data.members[0] == request.auth.uid
             && exists(/databases/$(database)/documents/requests/$(request.resource.data.members[1] + '_' + request.auth.uid)))
         || (request.resource.data.members[1] == request.auth.uid
             && exists(/databases/$(database)/documents/requests/$(request.resource.data.members[0] + '_' + request.auth.uid))));
      allow update: if signedIn() && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members;

      // Sesli mesajların ses verisi: mesaj listesini hafif tutmak için ayrı belgede
      match /audio/{id} {
        allow read, delete: if signedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        allow create: if signedIn() && request.resource.data.from == request.auth.uid &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
      }

      match /messages/{msgId} {
        allow read: if signedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        allow create: if signedIn() && request.resource.data.from == request.auth.uid &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        allow delete: if signedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
      }
    }
    match /live/{id} {
      allow read: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
      allow create: if signedIn() && request.resource.data.from == request.auth.uid
        && (exists(/databases/$(database)/documents/chats/$(request.auth.uid + '_' + request.resource.data.to))
         || exists(/databases/$(database)/documents/chats/$(request.resource.data.to + '_' + request.auth.uid)));
      allow update, delete: if signedIn() && (resource.data.from == request.auth.uid || resource.data.to == request.auth.uid);
    }
  }
}
